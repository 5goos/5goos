---
import { COMPANY_INFO } from '../data/projects';
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border-subtle)] bg-[var(--nav-bg)] backdrop-blur-md transition-all duration-200"
  id="navbar"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="group flex items-center gap-3 transition-opacity duration-150 hover:opacity-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-500 rounded-md py-1"
      aria-label="5GOOS Homepage"
    >
      <div class="relative flex h-10 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-2.5 py-1 transition-all group-hover:border-[var(--border-hover)]">
        <picture>
          <source srcset="/logo-dark.png" media="(prefers-color-scheme: dark)" />
          <img
            src="/logo-light.png"
            alt="5GOOS Logo"
            width="70"
            height="34"
            class="h-7 sm:h-8 w-auto object-contain"
            loading="eager"
            decoding="async"
          />
        </picture>
      </div>

      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="text-base font-bold tracking-tight text-[var(--text-primary)]">5GOOS</span>
          <span class="rounded border border-purple-500/30 bg-purple-500/10 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-purple-400">
            GOOSS
          </span>
        </div>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium" aria-label="Main Navigation">
      <a
        href="#projects"
        class="text-[var(--text-secondary)] transition-colors duration-150 hover:text-[var(--text-primary)] focus:outline-none focus-visible:text-[var(--text-primary)]"
      >
        Projects
      </a>
      <a
        href="#about"
        class="text-[var(--text-secondary)] transition-colors duration-150 hover:text-[var(--text-primary)] focus:outline-none focus-visible:text-[var(--text-primary)]"
      >
        About
      </a>
      <a
        href="#contact"
        class="text-[var(--text-secondary)] transition-colors duration-150 hover:text-[var(--text-primary)] focus:outline-none focus-visible:text-[var(--text-primary)]"
      >
        Contact
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={COMPANY_INFO.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-1.5 text-xs font-medium text-[var(--text-primary)] transition-all duration-150 hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)] focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-500"
        aria-label="5GOOS GitHub Organization (opens in new tab)"
      >
        <svg
          class="h-4 w-4 fill-current text-[var(--text-primary)]"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          />
        </svg>
        <span class="font-mono">GitHub</span>
        <svg class="h-3 w-3 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex md:hidden items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--border-hover)] focus:outline-none focus:ring-2 focus:ring-purple-500"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="h-5 w-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-[var(--border-subtle)] bg-[var(--nav-bg)] px-4 pt-2 pb-6 backdrop-blur-xl transition-all duration-200"
  >
    <div class="space-y-1.5 pt-2">
      <a
        href="#projects"
        class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-surface-elevated)] hover:text-[var(--text-primary)]"
      >
        Projects
      </a>
      <a
        href="#about"
        class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-surface-elevated)] hover:text-[var(--text-primary)]"
      >
        About
      </a>
      <a
        href="#contact"
        class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-[var(--text-secondary)] hover:bg-[var(--bg-surface-elevated)] hover:text-[var(--text-primary)]"
      >
        Contact
      </a>
    </div>

    <div class="mt-4 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-mono text-[var(--text-secondary)]">
      <span>5GOOS // GOOSS</span>
      <a
        href={COMPANY_INFO.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-purple-400 hover:underline"
      >
        github.com/5goos ↗
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu(show?: boolean) {
    const isExpanded = show !== undefined ? show : toggleBtn?.getAttribute('aria-expanded') === 'true';
    const newState = !isExpanded;

    toggleBtn?.setAttribute('aria-expanded', String(newState));
    if (newState) {
      mobileMenu?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  }

  toggleBtn?.addEventListener('click', () => {
    const currentState = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleMenu(currentState);
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      toggleMenu(true);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
      toggleMenu(true);
    }
  });
</script>
