---
import { PROJECTS } from '../data/projects';

const botoview = PROJECTS[0];
---

<section id="projects" class="relative py-20 sm:py-28" aria-labelledby="projects-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span>
          <span>// PROJECTS</span>
        </div>
        <h2 id="projects-title" class="mt-2 text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
          Open-Source Cloud Projects
        </h2>
        <p class="mt-3 text-base text-[var(--text-secondary)] leading-relaxed">
          Focused developer utilities and web applications engineered for modern cloud operations and observability.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={botoview.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3.5 py-2 font-mono text-xs font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)]"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub Repository ↗</span>
        </a>
      </div>
    </div>

    <article
      class="mt-8 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:p-10 transition-all duration-200 hover:border-[var(--border-hover)] shadow-xl relative overflow-hidden"
    >
      <div class="pointer-events-none absolute -top-24 right-0 h-64 w-64 rounded-full bg-cyan-500/10 blur-3xl" aria-hidden="true"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 space-y-6">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 font-mono text-xs font-semibold text-cyan-600 dark:text-cyan-400">
              <span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span>
              WEB APPLICATION
            </span>
            <span class="rounded-full border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-3 py-1 font-mono text-xs text-[var(--text-secondary)]">
              AWS Boto3 &amp; Botocore
            </span>
            <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 font-mono text-xs text-[#10B981]">
              Open Source
            </span>
          </div>

          <div>
            <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text-primary)]">
              {botoview.title}
            </h3>
            <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">
              {botoview.tagline}
            </p>
          </div>

          <p class="text-base text-[var(--text-primary)] leading-relaxed">
            {botoview.description}
          </p>

          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            {botoview.longDescription}
          </p>

          <div class="pt-2">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[var(--text-tertiary)]">
              What You Can Do
            </h3>
            <ul class="mt-3 space-y-2.5 text-sm text-[var(--text-secondary)]">
              {botoview.highlights.map((highlight) => (
                <li class="flex items-start gap-2.5">
                  <svg class="h-4 w-4 shrink-0 text-cyan-500 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-[var(--text-primary)]">{highlight}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap gap-2 pt-2">
            {botoview.tags.map((tag) => (
              <span class="rounded-md border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-2.5 py-1 font-mono text-xs text-[var(--text-secondary)]">
                {tag}
              </span>
            ))}
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href={botoview.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg bg-cyan-500 text-white dark:bg-cyan-400 dark:text-[#09090B] px-5 py-2.5 text-sm font-semibold shadow-sm transition-all hover:bg-cyan-600 dark:hover:bg-cyan-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500"
            >
              <span>Launch BotoView Web App</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <a
              href={botoview.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-2.5 text-sm font-medium text-[var(--text-primary)] transition-colors hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)]"
            >
              <span>Source on GitHub</span>
              <svg class="h-4 w-4 text-[var(--text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-canvas)] p-5 font-mono text-xs">
            <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3 text-[var(--text-tertiary)]">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-[var(--border-subtle)]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[var(--border-subtle)]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[var(--border-subtle)]"></span>
              </div>
              <span class="text-[11px] text-[var(--text-secondary)] flex items-center gap-1">
                <svg class="h-3 w-3 text-cyan-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                botoview.5goos.com
              </span>
            </div>

            <div class="mt-4 space-y-3">
              <div class="text-[11px] font-semibold text-[var(--text-primary)] flex items-center justify-between">
                <span>RECENT RELEASES</span>
                <span class="text-[10px] text-cyan-600 dark:text-cyan-400">AWS BOTO3 TIMELINE</span>
              </div>

              <div class="rounded-lg bg-[var(--bg-surface)] p-3 border border-[var(--border-subtle)] space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-[var(--text-primary)] font-bold text-xs flex items-center gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-cyan-500"></span>
                    boto3 release
                  </span>
                  <span class="text-[10px] rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 px-1.5 py-0.5 font-medium">latest</span>
                </div>
                <div class="text-[var(--text-secondary)] text-[11px] leading-relaxed">
                  Service additions, API changes, and parameter updates across AWS services.
                </div>
              </div>

              <div class="rounded-lg bg-[var(--bg-surface)] p-3 border border-[var(--border-subtle)] space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-[var(--text-primary)] font-bold text-xs flex items-center gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-purple-500"></span>
                    botocore updates
                  </span>
                  <span class="text-[10px] text-[var(--text-tertiary)]">service models</span>
                </div>
                <div class="text-[var(--text-secondary)] text-[11px] leading-relaxed">
                  JSON model updates, endpoint definitions, and request signing changes.
                </div>
              </div>

              <div class="mt-2 rounded-lg bg-[var(--bg-surface)] p-2.5 border border-[var(--border-subtle)] flex items-center justify-between text-[var(--text-tertiary)] text-[11px]">
                <div class="flex items-center gap-2">
                  <svg class="h-3.5 w-3.5 text-[var(--text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                  <span>Filter by AWS service (e.g. S3, EC2)...</span>
                </div>
                <span class="text-[10px] text-cyan-600 dark:text-cyan-400 font-semibold">Instant</span>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-canvas)] p-4 text-xs font-mono flex items-center justify-between">
            <span class="text-[var(--text-secondary)]">Direct web access:</span>
            <a
              href="https://botoview.5goos.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-cyan-600 dark:text-cyan-400 hover:underline flex items-center gap-1 font-semibold"
            >
              <span>botoview.5goos.com</span>
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
