---
---

<section id="about" class="relative py-20 sm:py-28 border-t border-[var(--border-subtle)]" aria-labelledby="about-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400">
        <span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span>
        <span>// ABOUT 5GOOS</span>
      </div>
      <h2 id="about-title" class="mt-2 text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
        Focused Cloud Tooling, Built Open
      </h2>
      <p class="mt-3 text-base text-[var(--text-secondary)] leading-relaxed">
        5GOOS (Global Observability &amp; Operations Software Solutions — GOOSS) develops fast, low-overhead open-source utilities for cloud developers, platform engineers, and SREs.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:p-8 transition-all duration-200 hover:border-[var(--border-hover)]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] text-purple-600 dark:text-purple-400 font-mono font-bold text-sm">
          01
        </div>
        <h3 class="mt-5 text-lg font-bold text-[var(--text-primary)]">Zero Bloat</h3>
        <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">
          No mandatory sign-ups, email walls, or resource-heavy background agents. Fast, lightweight utilities that do one job reliably.
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:p-8 transition-all duration-200 hover:border-[var(--border-hover)]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] text-[#10B981] font-mono font-bold text-sm">
          02
        </div>
        <h3 class="mt-5 text-lg font-bold text-[var(--text-primary)]">Open Source</h3>
        <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">
          Public repositories, permissive open-source licenses, and transparent issue tracking for developer community collaboration.
        </p>
      </div>
    </div>
  </div>
</section>
