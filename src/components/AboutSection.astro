---
import { COMPANY_INFO } from '../data/projects';
---

<section id="about" class="relative py-20 sm:py-28 border-t border-[var(--border-subtle)]" aria-labelledby="about-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400">
        <span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span>
        <span>// ABOUT 5GOOS</span>
      </div>
      <h2 id="about-title" class="mt-2 text-3xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-4xl">
        Focused Cloud Tooling, Built Open
      </h2>
      <p class="mt-3 text-base text-[var(--text-secondary)] leading-relaxed">
        5GOOS (Global Observability &amp; Operations Software Solutions — GOOSS) develops fast, low-overhead open-source utilities for cloud developers, platform engineers, and SREs.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:p-8 transition-all duration-200 hover:border-[var(--border-hover)]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] text-purple-600 dark:text-purple-400 font-mono font-bold text-sm">
          01
        </div>
        <h3 class="mt-5 text-lg font-bold text-[var(--text-primary)]">Zero Bloat</h3>
        <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">
          No mandatory sign-ups, email walls, or resource-heavy background agents. Fast, lightweight utilities that do one job reliably.
        </p>
      </div>

      <div class="rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:p-8 transition-all duration-200 hover:border-[var(--border-hover)]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] text-[#10B981] font-mono font-bold text-sm">
          02
        </div>
        <h3 class="mt-5 text-lg font-bold text-[var(--text-primary)]">Open Source</h3>
        <p class="mt-2 text-sm text-[var(--text-secondary)] leading-relaxed">
          Public repositories, permissive open-source licenses, and transparent issue tracking for developer community collaboration.
        </p>
      </div>
    </div>

    <div
      class="mt-8 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-6 sm:p-8 transition-all duration-200 hover:border-[var(--border-hover)] relative overflow-hidden"
      itemscope
      itemtype="https://schema.org/Person"
    >
      <div class="pointer-events-none absolute -top-20 -right-20 h-48 w-48 rounded-full bg-purple-500/10 blur-3xl" aria-hidden="true"></div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400">
            <span>// LEADERSHIP &amp; ENGINEERING</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--text-primary)]">
            Founded by <span itemprop="name">Naveen Thurimerla</span>
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            <span itemprop="worksFor" itemscope itemtype="https://schema.org/Organization"><span itemprop="name">5GOOS</span></span> was founded by <strong class="text-[var(--text-primary)] font-medium">Naveen Thurimerla</strong>, an infrastructure engineer focused on eliminating friction in cloud operations. Guided by the philosophy of high signal and zero operational overhead, Naveen leads the architecture and development of 5GOOS initiatives, including flagship open-source utilities like BotoView.
          </p>
        </div>

        <div class="flex flex-wrap md:flex-col gap-2.5 shrink-0 font-mono text-xs">
          <div class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-3 py-2 text-[var(--text-secondary)]">
            <span class="block text-[10px] uppercase text-[var(--text-tertiary)] font-sans">Role</span>
            <span itemprop="jobTitle" class="text-[var(--text-primary)] font-medium">Founder &amp; Principal Engineer</span>
          </div>
          <div class="flex items-center gap-2">
            <a
              href="https://www.thurimerla.com"
              target="_blank"
              rel="noopener noreferrer"
              itemprop="url"
              class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-3 py-2 text-[var(--text-primary)] hover:border-purple-500/50 hover:bg-[var(--bg-surface-elevated)] transition-colors"
            >
              <span>thurimerla.com ↗</span>
            </a>
            <a
              href={COMPANY_INFO.founder.github}
              target="_blank"
              rel="noopener noreferrer"
              itemprop="sameAs"
              class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-canvas)] px-3 py-2 text-[var(--text-primary)] hover:border-[var(--border-hover)] hover:bg-[var(--bg-surface-elevated)] transition-colors"
            >
              <span>@na8t ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
