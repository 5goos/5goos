---
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SEOHead {title} {description} {canonical} {ogImage} />
  </head>
  <body class="relative min-h-screen bg-[var(--bg-canvas)] text-[var(--text-primary)] font-sans antialiased selection:bg-purple-500/20 overflow-x-hidden">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--bg-surface)] focus:text-purple-500 focus:border focus:border-purple-500 focus:rounded-md focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 -left-40 h-[600px] w-[600px] rounded-full bg-radial from-purple-500/10 via-transparent to-transparent blur-3xl opacity-70"></div>
      <div class="absolute top-[20%] -right-40 h-[700px] w-[700px] rounded-full bg-radial from-cyan-500/8 via-transparent to-transparent blur-3xl opacity-60"></div>
      <div class="absolute -bottom-40 left-1/3 h-[500px] w-[500px] rounded-full bg-radial from-purple-500/6 via-transparent to-transparent blur-3xl opacity-40"></div>
    </div>

    <div class="relative z-10 flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>
